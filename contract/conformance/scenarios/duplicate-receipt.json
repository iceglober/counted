{
  "id": "SDK-040",
  "title": "a deduplicated event is settled, not resent",
  "script": [
    { "do": "track", "name": "a" },
    { "do": "flush" },
    { "expect": "request", "events": ["a"] },
    {
      "respond": {
        "status": 202,
        "body": {
          "accepted": 0,
          "deduplicated": 1,
          "rejected": 0,
          "outcomes": [{ "index": 0, "accepted": true, "deduplicated": true }]
        }
      }
    },
    { "do": "flush" },
    { "expect": "no-request" }
  ]
}
