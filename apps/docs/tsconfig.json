{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "preserve",
    "types": [
      "bun",
      "node"
    ],
    "noEmit": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "resolvePackageJsonImports": true
  },
  "include": [
    "src",
    "next.config.ts"
  ]
}
