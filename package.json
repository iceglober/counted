{
  "name": "counted",
  "private": true,
  "description": "Privacy-focused app analytics with composable dashboards",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iceglober/counted.git"
  },
  "homepage": "https://counted.dev",
  "packageManager": "bun@1.2.0",
  "workspaces": [
    "packages/*",
    "packages/adapters/*",
    "apps/*",
    "contract/conformance"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "conformance": "bun test contract/conformance",
    "test:migrate": "bun test tests/migrate/migrate.e2e.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "setup": "bash scripts/setup.sh",
    "seed": "bun scripts/seed.ts",
    "stripe:setup": "bun scripts/stripe-setup.ts",
    "indexnow": "bun scripts/indexnow.ts",
    "syndicate:devto": "bun scripts/syndicate-devto.ts",
    "changeset": "npx @changesets/cli",
    "version-packages": "npx @changesets/cli version",
    "release": "npx @changesets/cli publish",
    "arch": "depcruise packages/domain/src packages/contracts/src packages/ports/src packages/application/src packages/adapters apps --config .dependency-cruiser.cjs",
    "build:v2": "tsc --build tsconfig.build.json",
    "test:v2": "bun run agents:build && bun test packages/domain packages/contracts packages/ports packages/application packages/adapters packages/sdk-js packages/agent-core packages/agent-cli packages/aptabase-compat packages/migrate apps contract/conformance && bun run --cwd packages/react test",
    "openapi:generate": "bun scripts/generate-openapi.ts",
    "openapi:check": "bun scripts/generate-openapi.ts && git diff --exit-code -- openapi.json",
    "typecheck:v2": "tsc -p tsconfig.typecheck.json",
    "contract:generate": "bun scripts/generate-contract.ts",
    "contract:check": "bun scripts/generate-contract.ts && git diff --exit-code -- packages/sdk-js/src/gen packages/python/counted/_contract.py packages/go/contract_gen.go packages/rust/src/contract.rs packages/agent-core/src/gen packages/domain/src/ingest/gen",
    "conformance:build": "cd packages/rust && cargo build --bin conformance && cd ../go && go build -o bin/conformance ./cmd/conformance",
    "readmes": "bun scripts/check-sdk-readmes.ts",
    "agents:build": "bun run --cwd packages/agent-cli build && bun run --cwd packages/agent-claude-code build && bun run --cwd packages/agent-opencode build"
  },
  "dependencies": {
    "@counted/api": "workspace:*",
    "@counted/sdk": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "better-auth": "^1.6.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.17.0",
    "next": "^16.2.6",
    "pg": "^8.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-grid-layout": "^2.2.3",
    "resend": "^6.12.4",
    "sonner": "^2.0.7",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@eslint/eslintrc": "^3.3.5",
    "@happy-dom/global-registrator": "^20.11.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "dependency-cruiser": "^18.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.1",
    "eslint-config-next": "^16.2.6",
    "happy-dom": "^20.11.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "resolutions": {
    "kysely": "0.28.17"
  }
}
