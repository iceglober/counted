# dependencies
node_modules/

# next.js
.next/
.next-*/
out/

# build
dist/

# the RIR downloads `bun run geo:build` caches. The TABLE it produces
# (packages/ingestion/adapter-geoip/data/ip-country.bin) IS committed; the
# 20MB of registry text it was built from is not.
.geo-cache/

# env
.env
.env.local
.env.*.local

# editor
.vscode/
.idea/
*.swp
*.swo

# os
.DS_Store
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# turbo
.turbo/

# drizzle
drizzle/meta/
.playwright-cli/
__pycache__/
*.pyc

# rust build output (packages/rust)
packages/rust/target/
packages/rust/Cargo.lock

# npm auth (never commit tokens)
.npmrc

# playwright
test-results/
playwright-report/
blob-report/
/.playwright
/tests/e2e/.auth

# Claude Code harness artifacts (per-machine runtime state / local plugin installs)
.claude/scheduled_tasks.lock
.claude/plugins/

# Scratch projects built by `bun run readmes` (kept only when a check fails).
.readme-check/
.neon
