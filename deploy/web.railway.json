{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/web.Dockerfile",
    "watchPatterns": ["apps/web/**", "packages/contracts/**", "package.json", "bun.lock", "deploy/web.*"]
  },
  "deploy": {
    "healthcheckPath": "/",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "numReplicas": 1,
    "overlapSeconds": 20,
    "drainingSeconds": 10
  }
}
