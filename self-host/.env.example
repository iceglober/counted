# Copy to .env. Set a unique auth secret and database password before starting.

# Signs sessions and tokens. Never ship the default:  openssl rand -hex 32
COUNTED_AUTH_SECRET=

# Public addresses reached from a browser, without trailing slashes.
# Docs links, metadata, and API examples use these at runtime.
BASE_URL=http://localhost:3000
API_URL=http://localhost:8080
DOCS_URL=http://localhost:3001
MCP_URL=http://localhost:3002/mcp

POSTGRES_PASSWORD=counted

# Recovery, verification, invitation, sign-in and monitor mail (both or neither).
# Without them, use password sign-up/sign-in; email actions are unavailable.
# RESEND_API_KEY=
# COUNTED_MAIL_FROM=Counted <hello@example.com>

# Social providers are optional; set both values for each enabled provider.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional outbound monitor webhooks; receivers verify Standard Webhooks signatures.
# COUNTED_WEBHOOK_SIGNING_SECRET=

# How many reverse proxies sit in front of the API. 0 means no country is
# derived for events; 1 if there is exactly one trusted proxy.
COUNTED_TRUSTED_PROXY_HOPS=0
