# Copy to .env.local and adjust. `.env.local` is gitignored, wins over these,
# and is loaded by BOTH `scripts/dev.sh` and Bun itself — so a stale variable
# name in it stops `apps/api` from starting even when your shell is right.
#
# `apps/api` reads its environment once, at startup, and refuses to start with
# every problem printed at once. That is deliberate: v1 read
# STRIPE_WEBHOOK_SECRET inside the webhook handler, so a missing secret was
# discovered by the first customer to pay.

# --- required by apps/api ----------------------------------------------------

# The local database — keep it that way. `bun run dev`, `bun run journey` and
# the live test suites all use the local compose database regardless of this
# value; to point one of them at a hosted database on purpose, pass
# COUNTED_DEV_DATABASE_URL, COUNTED_JOURNEY_DATABASE_URL or
# COUNTED_TEST_DATABASE_URL explicitly for that run. Keep hosted URLs (Neon and
# the like) under names nothing reads, e.g. NEON_DATABASE_URL, and pass them
# where you mean them.
DATABASE_URL=postgres://counted:counted@localhost:5434/counted

# Where analytics reads and the worker's compactor connect. Defaults to
# DATABASE_URL, which is right locally. On Neon or any other provider that
# hands out a pooled URL, point this at the DIRECT host: segment reads through
# a transaction-mode pooler are slower, and the compactor's LISTEN does not
# work through one at all (it falls back to its timer, a few seconds slower).
# COUNTED_DATABASE_DIRECT_URL=postgres://.../counted

# The API's public origin, or its private upstream when configured on apps/web.
# COUNTED_CONSOLE_URL is always browser-facing. No trailing slash.
COUNTED_API_URL=http://localhost:8080
COUNTED_CONSOLE_URL=http://localhost:3000
# Public pages share the web service. Only this host renders the public homepage.
# app.counted.dev and ordinary localhost keep the console root flow.
COUNTED_SITE_URL=https://counted.dev
# Public destinations read at runtime by web and docs, including canonical URLs,
# Explorer links and OpenAPI examples. Hosted origins are the code defaults.
COUNTED_DOCS_URL=http://localhost:3001
# API URL published in docs; COUNTED_API_URL may be an internal address.
COUNTED_PUBLIC_API_URL=http://localhost:8080

# MCP uses the issuer in the API's OAuth discovery document, including its auth path.
# scripts/dev.sh derives these from its configured API/MCP ports when omitted.
# COUNTED_OAUTH_ISSUER=http://localhost:8080/api/auth
# COUNTED_MCP_RESOURCE=http://localhost:3002/mcp
# COUNTED_MCP_URL=http://localhost:3002/mcp

# Signs better-auth's cookies and tokens. There is no default and there must not
# be one: a shipped default secret is a shipped session-forgery key. Generate a
# real one for anything but a throwaway local database:
#
#   openssl rand -hex 32
COUNTED_AUTH_SECRET=dev-secret-not-for-production-0123456789abcdef

# Where an anonymously-provisioned project's ingest key is issued and who is
# recorded as issuing it. The API CREATES both rows at boot if they are not
# there — an organization, a member, and a named account with an unroutable
# address that nobody can sign in as — so these work on a database that has
# never seen a signup. Point them at a workspace and account you already own
# and nothing is created: an existing row is never modified, and a standing too
# junior to mint an ingest key is warned about at boot rather than discovered
# by the first anonymous caller.
#
# `apps/worker` reads these two and COUNTED_AUTH_SECRET / COUNTED_API_URL as an
# all-or-nothing group of its own: with them it runs the provisioning
# reconciler, which finds projects whose ingest key was never issued (a crash
# between the two stores) and issues one. Without them that job reports
# `available: false` and names what is missing.
COUNTED_UNCLAIMED_WORKSPACE_ID=ws_holding
COUNTED_UNCLAIMED_WORKSPACE_OWNER_ID=acct_operator

# --- optional, and all-or-nothing where grouped ------------------------------

# The port apps/api binds. `scripts/dev.sh` sets 8080; the code's own default is
# 3001, and the script wins in development because it is what starts the process.
# PORT=8080

# debug | info | warn | error
# LOG_LEVEL=info

# Sign-in email. Both or neither: a half-configured group is refused at startup,
# because Resend with a key and no from-address is worse than Resend absent.
# Left off, email-dependent sign-in, recovery and invitation actions are unavailable.
# RESEND_API_KEY=re_...
# COUNTED_MAIL_FROM=Counted <hello@auth.counted.dev>

# Social sign-in. Each provider is a pair and each pair is all-or-nothing: a
# client id with no secret is refused at startup rather than offered as a
# button that fails after the redirect. Neither pair set: the console offers
# email/password, plus magic links when mail delivery is configured.
#
# Register the callback with the provider as
# <COUNTED_CONSOLE_URL>/api/auth/callback/github (and .../callback/google) —
# the CONSOLE's origin, not the API's. The console proxies that path to the
# API, and the session cookie has to be set on the origin the reader is
# looking at. The API sends the provider the same URL when it exchanges the
# code, and the two must match or the provider refuses.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# Sign-in, sign-up and magic-link requests are limited to five a minute per
# client address per API process. Counters expire in memory and reset on restart;
# no address or address-derived identifier is persisted for these limits.
# The address is resolved with COUNTED_TRUSTED_PROXY_HOPS below — the same rule
# geography uses — so a forged X-Forwarded-For buys no fresh bucket.

# Billing. All four or none — Stripe with a secret key and no webhook secret
# means checkout works, the webhook that grants the plan does not, and the
# customer has paid for nothing. Test-mode keys only; never a live key here.
#
# Leave them unset for development: `bun run dev` supplies a stand-in that
# serves Stripe's paths and its own checkout page, so the upgrade runs locally
# end to end. Setting a real test-mode key here turns the stand-in off and
# talks to Stripe. (`STRIPE_API_BASE` is what points the SDK at either one.)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_ANNUAL=price_...
#
# Where the provider's API lives, when it is not the provider — `stripe-mock`,
# or the stub `tests/journey` starts. Optional and outside the group above: it
# redirects a configuration that already exists rather than being part of one.
# Never set in production.
# STRIPE_API_BASE=http://127.0.0.1:12111

# Signs outbound monitor webhooks (Standard Webhooks). Monitors with a webhook
# channel send an empty signature without it.
# COUNTED_WEBHOOK_SIGNING_SECRET=

# How many reverse proxies append to `X-Forwarded-For` in front of apps/api.
# This is the number that decides whether a caller can choose its own country:
# the address is read that many entries back from the END of the list, so a
# value the client invented sits harmlessly at the front. One is the deployed
# topology (the platform edge). A CDN in front of that makes it two.
#
# Set it to 0 where nothing in front is trusted to set the header — no country
# is derived at all, which is the honest answer to "I cannot tell whose address
# this is". Locally there is no proxy, so the value only matters if you send the
# header by hand.
# COUNTED_TRUSTED_PROXY_HOPS=1

# Decoded analytics segments kept in memory per process, in MiB. The API
# defaults to 256, the worker to 64.
# COUNTED_SEGMENT_CACHE_MB=256

# The worker's compactor: pack cadence (NOTIFY wakes it sooner), how long a
# partial segment may wait, when to warn about lag, and how often to merge,
# apply retention and vacuum.
# COUNTED_PACK_INTERVAL_SECONDS=10
# COUNTED_PACK_MAX_STAGING_AGE_SECONDS=60
# COUNTED_PACK_LAG_WARN_SECONDS=300
# COUNTED_SEGMENT_MAINTENANCE_INTERVAL_SECONDS=3600

# Where the MCP server is reached, when it is not the API's own origin. Tokens
# are bound to this URL; the MCP server must be given the same string as
# COUNTED_MCP_RESOURCE.
# COUNTED_MCP_URL=https://mcp.counted.dev/mcp

# COUNTED_CLAIM_GRANT_HOURS=72
# COUNTED_SHARE_LINK_DAYS=30
# COUNTED_QUERY_DEADLINE_MS=10000
# COUNTED_SERVICE_NAME=counted-api
